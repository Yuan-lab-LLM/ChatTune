# trusted_network is the default and relies on network isolation.
INFERENCE_OPS_AUTH_MODE=trusted_network
# Required only when INFERENCE_OPS_AUTH_MODE=token.
# INFERENCE_OPS_API_TOKEN=replace-with-a-long-random-token
INFERENCE_OPS_CONFIG_DIR=/etc/inference-ops
INFERENCE_OPS_STATE_DIR=/var/lib/inference-ops

# Experiment records: each worker uses its own Runtime node identity/token.
# Keep INFERENCE_OPS_STATE_DIR persistent across worker restarts.
# The main Agent backend initializes these automatically after manual startup.
# This also works with START_LOCAL_INFERENCE=false: no process is started or
# stopped. Local trusted_network deployments use Docker; remote provisioning
# uses a shared INFERENCE_OPS_API_TOKEN on the backend and inference processes.
# Credentials are stored privately at STATE_DIR/credentials/studio.json and
# restored after restart. The entries below are optional manual overrides.
# Copy this file to inference-ops/.env for automatic loading, or start with:
# python -m inference_ops --env-file /path/to/worker.env
# INFERENCE_OPS_ENV_FILE also selects a file (including for uvicorn imports).
# Existing process variables take precedence; values are literal, without
# shell expansion. Credentials are deployment settings, not config_update keys.
# STUDIO_URL=http://studio:3000
# MEDFLOW_RESOURCE_NODE_ID=your-runtime-node-id
# MEDFLOW_RUNTIME_NODE_TOKEN=the-node-specific-token-configured-in-studio
# Legacy MEDFLOW_STUDIO_NODE_TOKEN is also accepted. If both are set they
# must match; do not use the center-wide MEDFLOW_STUDIO_RUNTIME_TOKEN here.
# Experiment code is bundled in inference_ops/experiment_runtime, so this
# worker does not need access to the Agent container's filesystem.
# MEDFLOW_EXPERIMENT_UTILS_DIR=/opt/medflow/experiment_runtime

# LLM used by the controller role.
AGENT_LLM_URL=http://127.0.0.1:6000/v1
AGENT_LLM_MODEL=example-model-name
AGENT_LLM_API_KEY=EMPTY
